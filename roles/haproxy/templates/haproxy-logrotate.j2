# Logrotate configuration for HAProxy
# {{ ansible_managed }}

/var/log/haproxy/*.log {
    daily
    rotate 7
    missingok
    compress
    delaycompress
    notifempty
    create 0644 {{ haproxy_user }} {{ haproxy_group }}
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}
