# HAProxy configuration file generated by Ansible
# {{ ansible_managed }}

global
{% for key, value in haproxy_global.items() %}
{% if key == 'daemon' and value %}
    daemon
{% elif key == 'stats' %}
    stats {{ value }}
{% elif key == 'stats_timeout' %}
    stats timeout {{ value }}
{% elif key != 'daemon' %}
    {{ key }} {{ value }}
{% endif %}
{% endfor %}

defaults
{% if haproxy_defaults.mode is defined %}
    mode {{ haproxy_defaults.mode }}
{% endif %}
{% if haproxy_defaults.log is defined %}
    log {{ haproxy_defaults.log }}
{% endif %}
{% if haproxy_defaults.option is defined %}
{% for option in haproxy_defaults.option %}
    option {{ option }}
{% endfor %}
{% endif %}
{% if haproxy_defaults.maxconn is defined %}
    maxconn {{ haproxy_defaults.maxconn }}
{% endif %}
{% if haproxy_defaults.timeout is defined %}
{% for key, value in haproxy_defaults.timeout.items() %}
    timeout {{ key }} {{ value }}
{% endfor %}
{% endif %}

{% if haproxy_stats_enabled %}
# HAProxy Stats
listen stats
    bind {{ haproxy_stats_bind }}
    stats enable
    stats uri {{ haproxy_stats_uri }}
    stats refresh {{ haproxy_stats_refresh }}
    stats admin {{ haproxy_stats_admin }}

{% endif %}
{% if haproxy_prometheus_enabled %}
# HAProxy Prometheus Metrics
frontend prometheus
    bind {{ haproxy_prometheus_bind }}
    mode http
{% if haproxy_common_acl is defined
      and haproxy_common_acl.allowed_ip is defined
      and haproxy_common_acl.allowed_ip | length > 0 %}
    acl allowed_ip {{ haproxy_common_acl.allowed_ip }}
    acl metrics_path path {{ haproxy_prometheus_uri }}
    http-request deny unless allowed_ip
    http-request use-service prometheus-exporter if metrics_path
{% endif %}

{% endif %}
{% for listen_section in haproxy_listen_sections %}
# {{ listen_section.name }}
listen {{ listen_section.name | replace('.', '-') | replace(':', '-') }}
{% if listen_section.balance is defined %}
    balance {{ listen_section.balance }}
{% endif %}
    bind {{ listen_section.bind }}
{% if listen_section.mode is defined %}
    mode {{ listen_section.mode }}
{% endif %}
{% if listen_section.use_allowed_ip is defined and listen_section.use_allowed_ip %}
    acl allowed_ip {{ haproxy_common_acl.allowed_ip }}
{% endif %}
{% if listen_section.acl is defined %}
{% for acl in listen_section.acl %}
    acl {{ acl }}
{% endfor %}
{% endif %}
{% if listen_section.tcp_request is defined %}
{% for tcp_req in listen_section.tcp_request %}
    tcp-request {{ tcp_req }}
{% endfor %}
{% endif %}
{% if listen_section.http_request is defined %}
{% for http_req in listen_section.http_request %}
    http-request {{ http_req }}
{% endfor %}
{% endif %}
{% if listen_section.option is defined %}
{% for option in listen_section.option %}
    option {{ option }}
{% endfor %}
{% endif %}
{% if listen_section.timeout is defined %}
{% for key, value in listen_section.timeout.items() %}
    timeout {{ key }} {{ value }}
{% endfor %}
{% endif %}
{% if listen_section.server_group is defined %}
{% if hostvars[inventory_hostname]['haproxy_server_groups'] is defined and hostvars[inventory_hostname]['haproxy_server_groups'][listen_section.server_group] is defined %}
{% for server in hostvars[inventory_hostname]['haproxy_server_groups'][listen_section.server_group] %}
    server {{ server.name }}-{{ listen_section.name | replace('.', '-') | replace(':', '-') }} {{ server.ip }}:{{ listen_section.port }}{% if server.check %} check{% endif %}

{% endfor %}
{% endif %}
{% else %}
{% if haproxy_servers is defined and haproxy_servers|length > 0 %}
{% for server in haproxy_servers %}
    server {{ server.name }}-{{ listen_section.name | replace('.', '-') | replace(':', '-') }} {{ server.ip }}:{{ listen_section.port }}{% if server.check %} check{% endif %}

{% endfor %}
{% endif %}
{% endif %}

{% endfor %}
