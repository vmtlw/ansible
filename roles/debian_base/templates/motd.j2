#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
RESET='\033[0m'

EXTERNAL_IP=$(curl -s http://ipinfo.io/ip)
CPU_LOAD=$(uptime | awk -F'load average: ' '{ print $2 }')
MEM_USAGE=$(free -m | grep Mem | awk '{print $3 "/" $2 " (" $3/$2*100 "%" ")"}')
UPTIME=$(uptime -p | sed 's/up //')
TOP_PROCESSES=$(ps axch -o cmd:15,%mem --sort=-%mem | head -1)

echo -e "${CYAN}Добро пожаловать в $(hostname -f)!${RESET}"
echo "-----------------------------------"
echo -e "${RED}Внешний IP-адрес:${RESET} $EXTERNAL_IP"
echo -e "${YELLOW}Дата и время:${RESET} $(date)"
echo -e "${GREEN}Загрузка процессора (средняя за 1, 5 и 15 минут):${RESET} $CPU_LOAD"
echo -e "${BLUE}Использование оперативной памяти:${RESET} $MEM_USAGE"
echo -e "${CYAN}Самые прожорливый процессы:${RESET} ${RED} $TOP_PROCESSES ${RESET}"
echo "-----------------------------------"
